<?php
/**
 * Local XAMPP database settings.
 * Copy to config.local.php (gitignored) if the file is missing.
 */
if (!defined('APP_ENV')) {
    define('APP_ENV', 'local');
}
if (!defined('DB_SERVER')) {
    define('DB_SERVER', 'localhost');
}
if (!defined('DB_HOST')) {
    define('DB_HOST', 'localhost');
}
if (!defined('DB_PORT')) {
    define('DB_PORT', 3306);
}
if (!defined('DB_USERNAME')) {
    define('DB_USERNAME', 'root');
}
if (!defined('DB_PASSWORD')) {
    define('DB_PASSWORD', '');
}
if (!defined('DB_NAME')) {
    define('DB_NAME', 'ash_pos_db');
}
if (!defined('DB_SSL')) {
    define('DB_SSL', false);
}
if (!defined('DB_SSL_CA')) {
    define('DB_SSL_CA', '');
}

