Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Block sensitive bootstrap / credential files
RewriteRule ^(initialize\.(local|production)|config\.(local|production))\.php$ - [F,L]

# Allow existing files and folders (images, css, js, uploads)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SEO endpoints
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]
</IfModule>

<FilesMatch "^(initialize\.local\.php|initialize\.production\.php|config\.local\.php|config\.production\.php|\.env|\.env\.infinityfree|\.gitignore)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "^(config\.php|initialize\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
